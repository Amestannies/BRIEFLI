# ============================================================
# BRIEFLI — Complete Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# ⚠️  Never commit .env.local or any file with real credentials.
# ============================================================

# ── App URLs ──────────────────────────────────────────────────────────────────
# Local dev:   APP_URL=http://localhost:3000
# Production:  APP_URL=https://app.briefli.com
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get from: supabase.com → Project → Settings → Database → Connection string
# Use "Transaction" mode (port 6543) for DATABASE_URL (pooled)
# Use "Session" mode (port 5432) for DIRECT_URL (migrations)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_different_long_random_string
# AES-256 key for encrypting eCourts credentials (exactly 64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_64_hex_chars

# ── AWS S3 (Document Storage) ─────────────────────────────────────────────────
# 1. Go to AWS Console → S3 → Create Bucket (private, server-side encryption on)
# 2. Go to IAM → Users → Create User → Attach "AmazonS3FullAccess" → Create Access Key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=briefli-documents-dev
S3_REGION=us-east-1
AWS_S3_BUCKET=briefli-documents-dev

# ── Stripe (Card Payments) ────────────────────────────────────────────────────
# 1. Sign up at dashboard.stripe.com
# 2. Developers → API Keys → copy Secret key and Publishable key
# 3. For WEBHOOK_SECRET run: stripe listen --forward-to localhost:3001/api/v1/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayPal (PayPal Payments) ──────────────────────────────────────────────────
# 1. Sign up at developer.paypal.com
# 2. My Apps & Credentials → Create App → copy Client ID and Secret
# 3. Use sandbox for dev, switch to live for production
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create Project
# 2. APIs & Services → Enable "Google Calendar API"
# 3. Credentials → Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URI: http://localhost:3001/api/v1/calendar/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Microsoft Outlook OAuth ───────────────────────────────────────────────────
# 1. Go to portal.azure.com → Azure Active Directory → App registrations → New
# 2. Redirect URI: http://localhost:3001/api/v1/calendar/outlook/callback
# 3. Certificates & secrets → New client secret
# 4. API permissions → Add → Microsoft Graph → Calendars.ReadWrite (Delegated)
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at resend.com → API Keys → Create API Key
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# ── SMS (Twilio) — optional ───────────────────────────────────────────────────
# Sign up at console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# ── Notarization (Proof) — optional ──────────────────────────────────────────
PROOF_API_KEY=
PROOF_WEBHOOK_SECRET=

# ── WebSocket / Real-time Chat ────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Feature Flags ─────────────────────────────────────────────────────────────
ECOURTS_ENABLED=true
RON_ENABLED=false
